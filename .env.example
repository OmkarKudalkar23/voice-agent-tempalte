# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+17372508034
TWILIO_VERIFIED_TO_NUMBER=+918433550728

# Speech-to-Text: elevenlabs = Scribe v2 Realtime (default, same key as TTS),
# deepgram = Nova-3 fallback. STT_LANGUAGE empty = auto-detect.
STT_PROVIDER=elevenlabs
# STT_LANGUAGE=eng
# STT_VAD_SILENCE=1.0

# Speech-to-Text fallback (Deepgram Nova-3, also used by the Twilio path)
DEEPGRAM_API_KEY=your_deepgram_api_key

# LLM (OpenRouter — OpenAI-compatible, default model openai/gpt-4o-mini)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server Config
PORT=5000
PUBLIC_BASE_URL=https://your-ngrok-domain.ngrok-free.app

# Development Mock Mode (Set to true to test UI without consuming provider credits)
MOCK_AI=false

# GitHub agent (optional server fallback — per-call browser token takes precedence)
# Create a fine-grained PAT with Repository access (read/write) and paste it in
# the console header during a call instead. Token is memory-only, never stored.
# GITHUB_TOKEN=ghp_your_token_here

# Email agent via Resend (optional server fallback — per-call browser key takes precedence)
# Get a key at resend.com/api-keys. Test mode sends from onboarding@resend.dev.
# RESEND_API_KEY=re_your_key_here
# To send FROM your own address, verify the domain at resend.com/domains, then:
# EMAIL_FROM_ADDRESS=you@yourdomain.com
